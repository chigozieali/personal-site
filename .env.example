# Copy this file to .env.local and fill in the values.

# Postgres connection string from a Vercel Postgres (Neon) database.
# Vercel injects this for you when you attach the database to the project.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Password for the /settings editor. Never sent to the browser.
SETTINGS_PASSWORD="pick-something-long"

# Secret used to sign the settings session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# The contact form posts to Formspree. Its public form id is set in
# components/site/ContactForm.tsx, so nothing is needed here.

# Optional: enable the assistant in /settings with a provider API key.
# Google AI Studio offers a free tier for supported models:
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional alternative provider:
GROQ_API_KEY=""
# Optional paid provider:
OPENAI_API_KEY=""
# Optional model override. Defaults depend on the first configured provider:
# Gemini: gemini-3.8-flash; Groq: llama-3.3-70b-versatile; OpenAI: gpt-6-luna.
AI_MODEL=""
